# Copy this file to .env and fill in real values before deploying.
# Never commit the real .env file.

# Google Analytics 4 Measurement ID (from analytics.google.com)
# Leave blank / omit to disable analytics entirely.
VITE_GA_MEASUREMENT_ID=

# Google Search Console verification (HTML tag method).
# Paste just the content value from the meta tag Google gives you.
VITE_GSC_VERIFICATION=
